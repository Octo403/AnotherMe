# demo runs locally without API access. Set live to use your compatible provider.
AITOWN_MODE=demo
AGENT_NAME=AnotherMe
AGENT_LANGUAGE=中文
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
# Optional semantic vectors. Empty means local character TF-IDF + FAISS.
EMBEDDING_MODEL=
KNOWLEDGE_DIR=data/knowledge
# synthetic: bundled fictional documents; local_documents: your selected TXT/MD directory.
# This declaration does not automatically classify or sanitize files.
SOURCE_SCOPE=synthetic
# Legacy conversation import path; new turns use RUNTIME_DATABASE.
MEMORY_DB=data/runtime/memory.sqlite3
MEMORY_TTL_HOURS=168
HISTORY_TURNS=8
RETRIEVAL_THRESHOLD=0.15
# Optional local style corpus. Both paths required; empty scope retrieves nothing.
# Live mode sends selected observed style summaries/common words to the provider.
# Do not enable personal sources remotely without deciding the service/data scope.
STYLE_DATABASE=
STYLE_PROFILE=
STYLE_SCOPE=
STYLE_FEEDBACK=
# 可选：本人评分规则与去事件化训练示范 JSON。与画像、库同时配置，仍需显式 scope。
# Optional T7 local retrieval. Download public models with scripts/download_retrieval_models.py.
# Empty database keeps the existing synthetic TXT/MD demo. Personal queries require --scope.
RETRIEVAL_DATABASE=
RETRIEVAL_INDEX_DIR=data/runtime/retrieval
LOCAL_EMBEDDING_DIR=
LOCAL_RERANKER_DIR=
SEMANTIC_THRESHOLD=0.45
RERANK_THRESHOLD=0.01
RETRIEVAL_TOP_N=20
RETRIEVAL_TOP_K=4
# T11 measured this local BGE corpus with SEMANTIC_THRESHOLD=0.35 and RETRIEVAL_TOP_N=8.
# These are corpus-specific measurements; see docs/EVALUATION.md before tuning.
# Optional explicit paths; defaults use the retrieval/style application DB and a separate checkpoint DB.
RUNTIME_DATABASE=
CHECKPOINT_DB=
CONTEXT_TTL_SECONDS=600
# T9: bounded context and at most one malformed-JSON repair request.
CONTEXT_MAX_CHARS=6500
JSON_REPAIR_ATTEMPTS=1
# json_schema uses provider schema constraints when measured as supported.
# plain_json omits response_format for services without JSON-object mode.
LLM_RESPONSE_FORMAT=json_object
# Optional explicit transactional correction skill; disabled by default.
ENABLE_MEMORY_CORRECTION=false
# X3: separate public course question bank. API mode does not need local BGE.
QUESTION_BANK_DIR=data/question_bank
# none / api / codex_chatgpt. UI model settings can override these defaults.
# API receives course data + current search intent, never the personal corpus.
QUESTION_SIMILAR_PROVIDER=none
QUESTION_API_PROVIDER=deepseek
QUESTION_API_BASE_URL=https://api.deepseek.com
# Exact model ID from the provider; discover or enter it in the model settings UI.
QUESTION_API_MODEL=
QUESTION_API_KEY=
QUESTION_API_IMAGES=false
QUESTION_SIMILAR_MODEL=
QUESTION_SIMILAR_IMAGES=true
# basic / mineru (local SDK) / mineru_api (cloud, public FDU course originals only).
QUESTION_EXTRACTOR=basic
MINERU_API_KEY=
MINERU_API_MODEL=vlm
MINERU_TIMEOUT=900
MINERU_PYTHON=.venv-mineru/Scripts/python.exe
# flash is native extraction, not OCR; standard may download local VLM models.
MINERU_TIER=flash
# Optional offline Windows OCR (requires an installed Chinese OCR language pack).
# OCR page text is saved for review; unaudited math is not added to question search.
QUESTION_PDF_OCR=none
# Use 2 only for an explicitly checked PDF with two printed pages per scan.
QUESTION_OCR_COLUMNS=1
